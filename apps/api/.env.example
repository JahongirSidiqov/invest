# Local development values only. Real secrets come from the secrets manager.
NODE_ENV=development
PORT=3000

# Owner role: used by Prisma migrations
DATABASE_URL=postgresql://invest:invest@localhost:5432/invest
# Application role: not a superuser, so row-level security applies
APP_DATABASE_URL=postgresql://invest_app:invest_app@localhost:5432/invest
REDIS_URL=redis://localhost:6379

# openssl rand -base64 32  (each one different)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
PII_ENC_KEY=ZGV2LW9ubHktZW5jLWtleS0zMi1ieXRlcy0wMTIzNDU=
PII_HASH_KEY=ZGV2LW9ubHktaGFzaC1rZXktMzItYnl0ZXMtMDEyMzQ=

# console | <provider name once [SMS_PROVIDER] is chosen>
SMS_PROVIDER=console
