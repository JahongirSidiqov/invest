    "/v1/auth/otp/verify": {
      "post": {
        "operationId": "AuthController_verifyOtp",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  },
                  "device": {
                    "type": "object",
                    "properties": {
                      "platform": {
                        "type": "string",
                        "enum": [
                          "android",
                          "ios",
                          "web"
                        ]
                      },
                      "name": {
                        "type": "string",
                        "maxLength": 100
                      }
                    },
                    "required": [
                      "platform"
                    ]
                  },
                  "locale": {
                    "default": "uz",
                    "type": "string",
                    "enum": [
                      "uz",
                      "ru",
                      "en"
                    ]
                  }
                },
                "required": [
                  "phone",
                  "code",
                  "device"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string"
                    },
                    "accessTokenExpiresIn": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "refreshToken": {
                      "type": "string"
                    },
                    "refreshTokenExpiresIn": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "userId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "isNewUser": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "accessToken",
                    "accessTokenExpiresIn",
                    "refreshToken",
                    "refreshTokenExpiresIn",
                    "userId",
                    "isNewUser"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
